[Unit]
Description=TDS Sidekick (Django/gunicorn)
After=network.target

[Service]
Type=simple
User=sidekick
Group=sidekick
WorkingDirectory=/srv/tds-sidekick
EnvironmentFile=/etc/tds-sidekick/env
ExecStart=/srv/tds-sidekick/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --threads 4
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target